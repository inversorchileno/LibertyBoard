#include <winver.h>

/* Application Icon */

IDI_ICON1               ICON    DISCARDABLE     "OpenBoard.ico"
IDI_ICON2               ICON    DISCARDABLE     "OpenBoardDoc.ico"

/* Version Info */

VS_VERSION_INFO VERSIONINFO

FILEVERSION    	UBVERSION_RC

PRODUCTVERSION 	UBVERSION_RC

FILEFLAGSMASK  	VS_FFI_FILEFLAGSMASK

#ifdef PRE_RELEASE
FILEFLAGS       VS_FF_PRERELEASE
#endif

FILEOS         	VOS__WINDOWS32

FILETYPE       	VFT_APP

BEGIN

    BLOCK "StringFileInfo"

    BEGIN

        BLOCK "040904E4" /* U.S. English, code page 1252 */

        BEGIN

            VALUE "CompanyName",      "LibertyBoard\000"

            VALUE "FileDescription",  "LibertyBoard - pizarra y lector PDF (version modificada de OpenBoard)\000"

            VALUE "FileVersion",      UBVERSION

            VALUE "LegalCopyright",   "LibertyBoard, basado en OpenBoard (c) Open Education Foundation y colaboradores. GPLv3\000"

            VALUE "OriginalFilename", "LibertyBoard.exe\000"

            VALUE "ProductName",      "LibertyBoard\000"

            VALUE "ProductVersion",   UBVERSION

        END

    END

END

